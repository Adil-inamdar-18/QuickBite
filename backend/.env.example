PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/quickbite
JWT_SECRET=replace_with_a_long_random_secret_string
CLIENT_URL=http://localhost:5173

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary Image Uploads (optional - falls back to /uploads when omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP for Password Reset & Delivery OTPs (optional in local dev)
EMAIL=
PASS=

# Firebase Project ID for verifying Google Auth tokens
FIREBASE_PROJECT_ID=quick-bite-food-delivery-4d415
